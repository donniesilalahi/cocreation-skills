#!/bin/sh
# Auto-update memory-bank indices before each commit

REPO_ROOT="$(git rev-parse --show-toplevel)"
PKG_ROOT="$REPO_ROOT/cocreation-skills"

cd "$PKG_ROOT" || exit 1

# Run the index updater
node scripts/update-indices.js

# Stage any updated index files so they're included in the commit
cd "$REPO_ROOT" || exit 1
git diff --name-only | grep -E 'cocreation-skills/skills/[^/]+/memory-bank/(PLAN|ANALYSIS|LEARNING|IMPLEMENTATION)\.md$' | while read -r file; do
  git add "$file"
done

# Also stage untracked index files
git ls-files --others --exclude-standard | grep -E 'cocreation-skills/skills/[^/]+/memory-bank/(PLAN|ANALYSIS|LEARNING|IMPLEMENTATION)\.md$' | while read -r file; do
  git add "$file"
done
