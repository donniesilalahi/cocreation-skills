    "update-indices": "node scripts/update-indices.js",
    "prepack": "npm run update-indices && npm run validate"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skills",
    "workflow",
    "planning"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "picocolors": "^1.1.1"
  }
