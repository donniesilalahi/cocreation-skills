{
  "name": "@donniesilalahi/cocreation-skills",
  "version": "0.1.0",
  "description": "Reusable Agent Skills for planning, root cause analysis, implementation records, and lessons learned.",
  "type": "module",
  "bin": {
    "cocreation-skills": "cli.js"
  },
  "files": [
    "cli.js",
    "agents.js",
    "scripts/",
    "skills/",
    "template/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
