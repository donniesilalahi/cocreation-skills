#!/bin/sh
# Auto-update memory-bank indices before each commit (development hook)

cd "$(git rev-parse --show-toplevel)" || exit 1
node scripts/update-indices.js

git diff --name-only | grep -E '^skills/[^/]+/memory-bank/(PLAN|ANALYSIS|LEARNING|IMPLEMENTATION)\.md$' | while read -r file; do
  git add "$file"
done

git ls-files --others --exclude-standard | grep -E '^skills/[^/]+/memory-bank/(PLAN|ANALYSIS|LEARNING|IMPLEMENTATION)\.md$' | while read -r file; do
  git add "$file"
done
